{
  "name": "mosfeteer",
  "version": "0.7.4",
  "description": "A drawing tool for analog circuit schematics, for figures in papers, slides, and documentation.",
  "type": "module",
  "scripts": {
    "start": "node launch.mjs",
    "serve": "node --watch src/server/serve.js",
    "browser-only": "node scripts/build_browser_only.mjs",
    "cli": "node src/cli/index.js",
    "install-launcher": "node launch.mjs --install",
    "test": "node --test --test-concurrency=6 --test-timeout=180000 test/*.test.js test/browser/*.test.js",
    "test:ci": "node --test --test-concurrency=3 --test-timeout=180000 test/*.test.js test/browser/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
